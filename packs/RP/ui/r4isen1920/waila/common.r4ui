{
	/* r4isen1920によって作成されました | MITライセンス */

	"namespace": "r4isen1920_waila_common",

	"label": {
		"type": "label",

		"size": ["default", "default"],
		"font_scale_factor": 1.0,
		"localize": false,
		"shadow": true,
		"enable_profanity_filter": false,

		"layer": "($layer + 1)"
	},

	"image": {
		"type": "image",

		"force_texture_reload": true,
		"allow_debug_missing_texture": false,

		"layer": "($layer + 1)"
	},

	/* 子が非表示になったときに 0 へ折りたたまれるラッパー -- ignored の代替 */
	"collapsible@common.empty_panel": {
		"size": ["100%cm", "100%cm"]
	},

	/* 呼び出し側が icon_image を controls に差し込み、#texture をバインドする */
	"icon_renderer@common.empty_panel": {
		"size": ["100%c - 0.5px", "100%c - 0.5px"]
	},

	"icon_image@r4isen1920_waila_common.image": {
		"texture": "#texture",

		"size": [9, 9],
		"uv_size": [9, 9],

		"layer": 101
	}
}
